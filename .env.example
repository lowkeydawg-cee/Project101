# Copy this file to .env and fill it in. Never commit .env.
# The same variables must also be set in the Vercel project settings,
# or the live site will have no data.

# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS (optional). Without these the site still works: order emails are
# skipped, and the contact and quote forms fall back to WhatsApp instead of
# silently losing the message.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_ADMIN_TEMPLATE_ID=
VITE_EMAILJS_CUSTOMER_TEMPLATE_ID=
# Used by the contact form and the custom quote form
VITE_EMAILJS_INQUIRY_TEMPLATE_ID=
